<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PiCalc.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PiCalc.Controls"
        xmlns:util="clr-namespace:PiCalc.Util"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        Width="600" Height="400"
        CanResize="False"
        x:Class="PiCalc.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="PiCalc">
    <Design.DataContext>
        <vm:DesignMainWindowViewModel />
    </Design.DataContext>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="5">
        <Grid.Resources>
            <util:IntToDoubleConverter x:Key="IntToDoubleConverter" />
        </Grid.Resources>
        <StackPanel Grid.Column="0" Spacing="8">
            <TextBlock>
                <Run Text="Running " />
                <Run Text="{Binding Experiments}" />
                <Run Text="{Binding ExperimentLabels}" />
            </TextBlock>
            <NumericUpDown Value="{Binding Experiments}" Minimum="1"
                           IsEnabled="{Binding ToggleEnabled}" />

            <Slider Minimum="{Binding MinThreads, Converter={StaticResource IntToDoubleConverter}}"
                    Maximum="{Binding MaxThreads, Converter={StaticResource IntToDoubleConverter}}"
                    Value="{Binding Threads, Converter={StaticResource IntToDoubleConverter}}"
                    IsEnabled="{Binding ToggleEnabled}" />
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Threads}" />
                <TextBlock Text="{Binding ThreadLabels}" />
            </StackPanel>

            <ToggleSwitch Content="Progress" IsChecked="{Binding ProgressReporting}"
                          IsEnabled="{Binding ToggleEnabled}" />
            <ToggleSwitch Content="Render results" IsChecked="{Binding ResultRendering}"
                          IsEnabled="{Binding ToggleEnabled}" />
            <ToggleSwitch Content="Vectorized" IsChecked="{Binding VectorizedCalculation}"
                          IsEnabled="{Binding ToggleEnabled}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Start" Command="{Binding StartCommand}" />
                <Button Content="Stop" Command="{Binding StopCommand}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="8">
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" />
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ElapsedTimeText}" />

        </StackPanel>
    </Grid>
</Window>