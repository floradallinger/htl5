<util:ScopedControl xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:util="clr-namespace:PuppyAdoption.Util"
                    xmlns:views="clr-namespace:PuppyAdoption.Views"
                    xmlns:vm="clr-namespace:PuppyAdoption.ViewModels"
                    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                    x:DataType="vm:PuppyOverviewViewModel"
                    x:Class="PuppyAdoption.Views.PuppyOverview">
    <Design.DataContext>
        <vm:DesignPuppyOverviewViewModel />
    </Design.DataContext>
    <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
        <views:PuppyList Grid.Column="0" DataContext="{Binding PuppyListViewModel}" />
        <views:PuppyDetails Grid.Column="1" DataContext="{Binding PuppyDetailsViewModel}" />
    </Grid>
</util:ScopedControl>