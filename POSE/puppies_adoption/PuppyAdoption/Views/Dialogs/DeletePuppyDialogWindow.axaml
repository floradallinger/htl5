<util:ScopedWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:util="clr-namespace:PuppyAdoption.Util"
                   xmlns:viewModels="clr-namespace:PuppyAdoption.ViewModels"
                   mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                   x:Class="PuppyAdoption.Views.Dialogs.DeletePuppyDialogWindow"
                   x:DataType="viewModels:DeletePuppyDialogWindowViewModel"
                   Title="Delete Puppy">
    <Design.DataContext>
        <viewModels:DesignDeletePuppyDialogWindowViewModel />
    </Design.DataContext>
    <!-- TODO -->
    <Grid RowDefinitions="*,*,*,*" Margin="5">
        <TextBlock Grid.Row="0">Shelter Name:</TextBlock>
        <TextBox Grid.Row="1" Text="{Binding PuppyName}" PlaceholderText="Enter puppy name" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Command="{Binding CancelCommand}" VerticalAlignment="Center">Cancel</Button>
            <Button Command="{Binding DeleteCommand}" VerticalAlignment="Center">Delete Puppy</Button>
        </StackPanel>
        <ProgressBar Grid.Row="3" Orientation="Horizontal" IsIndeterminate="True" Margin="0,20, 0, 0"
                     IsVisible="{Binding Processing}" />
    </Grid>
</util:ScopedWindow>