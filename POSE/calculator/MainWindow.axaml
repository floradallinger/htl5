<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Calculator.MainWindow"
        Title="Calculator">
    <Grid Name="ButtonGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Content="7" Grid.Row="0" Grid.Column="0" Width="50" Height="50" Margin="2" />
        <Button Content="8" Grid.Row="0" Grid.Column="1" Width="50" Height="50" Margin="2" />
        <Button Content="9" Grid.Row="0" Grid.Column="2" Width="50" Height="50" Margin="2" />
        <Button Content="/" Grid.Row="0" Grid.Column="3" Width="50" Height="50" Margin="2" />
        <Button Content="*" Grid.Row="0" Grid.Column="4" Width="50" Height="50" Margin="2" />

        <Button Content="4" Grid.Row="1" Grid.Column="0" Width="50" Height="50" Margin="2" />
        <Button Content="5" Grid.Row="1" Grid.Column="1" Width="50" Height="50" Margin="2" />
        <Button Content="6" Grid.Row="1" Grid.Column="2" Width="50" Height="50" Margin="2" />
        <Button Content="+" Grid.Row="1" Grid.Column="3" Width="50" Height="50" Margin="2" />
        <Button Content="-" Grid.Row="1" Grid.Column="4" Width="50" Height="50" Margin="2" />

        <Button Content="1" Grid.Row="2" Grid.Column="0" Width="50" Height="50" Margin="2" />
        <Button Content="2" Grid.Row="2" Grid.Column="1" Width="50" Height="50" Margin="2" />
        <Button Content="3" Grid.Row="2" Grid.Column="2" Width="50" Height="50" Margin="2" />
        <Button Content="Clear" Foreground="Red" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Width="104"
                Height="50" Margin="2" />

        <Button Content="0" Grid.Row="3" Grid.Column="0" Width="50" Height="50" Margin="2" />
        <Button Content="." Grid.Row="3" Grid.Column="1" Width="50" Height="50" Margin="2" />
        <Button Content="=" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3" Width="158" Height="50" Margin="2" />
    </Grid>

</Window>